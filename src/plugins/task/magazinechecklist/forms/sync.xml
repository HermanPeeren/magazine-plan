<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fields name="params">
		<fieldset name="task_params">
			<field
				name="owner"
				type="text"
				label="PLG_TASK_MAGAZINECHECKLIST_FIELD_OWNER_LABEL"
				description="PLG_TASK_MAGAZINECHECKLIST_FIELD_OWNER_DESC"
				required="true"
				filter="string"
			/>
			<field
				name="repository"
				type="text"
				label="PLG_TASK_MAGAZINECHECKLIST_FIELD_REPOSITORY_LABEL"
				description="PLG_TASK_MAGAZINECHECKLIST_FIELD_REPOSITORY_DESC"
				required="true"
				filter="string"
			/>
			<field
				name="token"
				type="password"
				label="PLG_TASK_MAGAZINECHECKLIST_FIELD_TOKEN_LABEL"
				description="PLG_TASK_MAGAZINECHECKLIST_FIELD_TOKEN_DESC"
				required="true"
				filter="raw"
				autocomplete="off"
			/>
			<field
				name="plan_label"
				type="text"
				label="PLG_TASK_MAGAZINECHECKLIST_FIELD_PLAN_LABEL_LABEL"
				description="PLG_TASK_MAGAZINECHECKLIST_FIELD_PLAN_LABEL_DESC"
				default="issue plan"
				required="true"
				filter="string"
			/>
			<field
				name="imagery_label"
				type="text"
				label="PLG_TASK_MAGAZINECHECKLIST_FIELD_IMAGERY_LABEL_LABEL"
				description="PLG_TASK_MAGAZINECHECKLIST_FIELD_IMAGERY_LABEL_DESC"
				default="Imagery"
				filter="string"
			/>
			<field
				name="heading"
				type="text"
				label="PLG_TASK_MAGAZINECHECKLIST_FIELD_HEADING_LABEL"
				description="PLG_TASK_MAGAZINECHECKLIST_FIELD_HEADING_DESC"
				default="### Table of contents"
				required="true"
				filter="raw"
			/>
			<field
				name="max_pages"
				type="number"
				label="PLG_TASK_MAGAZINECHECKLIST_FIELD_MAX_PAGES_LABEL"
				description="PLG_TASK_MAGAZINECHECKLIST_FIELD_MAX_PAGES_DESC"
				default="10"
				min="1"
				max="100"
				step="1"
				filter="int"
			/>
			<field
				name="dry_run"
				type="radio"
				layout="joomla.form.field.radio.switcher"
				label="PLG_TASK_MAGAZINECHECKLIST_FIELD_DRY_RUN_LABEL"
				description="PLG_TASK_MAGAZINECHECKLIST_FIELD_DRY_RUN_DESC"
				default="1"
				filter="integer"
				>
				<option value="0">JNO</option>
				<option value="1">JYES</option>
			</field>
		</fieldset>
	</fields>
</form>
