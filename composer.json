{
    "name": "yepr/magazine-checklist",
    "description": "A Joomla task plugin that keeps the checklists in the Joomla Community Magazine's overview issues on GitHub in step with the issues' milestones",
    "type": "joomla-plugin",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Herman Peeren",
            "email": "herman@yepr.nl",
            "homepage": "https://yepr.nl"
        }
    ],
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0",
        "squizlabs/php_codesniffer": "^3.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Yepr\\Plugin\\Task\\MagazineChecklist\\": "src/plugins/task/magazinechecklist/src/",
            "Yepr\\Plugin\\Task\\MagazineChecklist\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "cs": "phpcs",
        "cs-fix": "php-cs-fixer fix",
        "cs-fix-dry": "php-cs-fixer fix --dry-run --diff",
        "build": "php build/build.php",
        "install-local": [
            "@build",
            "php tools/install-local.php"
        ],
        "cypress": "npx cypress run"
    },
    "config": {
        "sort-packages": true
    }
}
